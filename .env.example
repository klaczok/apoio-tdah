# Acesso individual (issue 04). Gere os valores com:
#   node scripts/hash-password.mjs <email-do-usuario>
AUTH_USER_EMAIL=
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# Persistência (issue 05). Produção usa o Postgres da Vercel. Ao conectar o
# banco ao projeto, as variáveis podem receber o prefixo do banco
# (ex.: planejador_pessoal_db_POSTGRES_URL); o adapter resolve qualquer
# variável com sufixo _POSTGRES_URL. Para desenvolvimento local com o banco
# real, copie a connection string em Vercel > Storage > .env.local:
POSTGRES_URL=
# Para desenvolvimento local sem banco, use o adapter em memória
# (o estado não sobrevive a reiniciar o processo):
# PERSISTENCE_DRIVER=memory
